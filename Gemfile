source 'https://rubygems.org'

# github-pages cannot install on Ruby 4 (commonmarker requires Ruby < 4).
# Jekyll 4 is used locally; GitHub Pages still builds the site on push.
gem 'jekyll', '~> 4.4'
gem 'kramdown-parser-gfm'

group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-seo-tag'
  gem 'jekyll-sitemap'
  gem 'jekyll-avatar'
end
